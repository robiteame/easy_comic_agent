# ============================================================
# AI 漫剧 Agent 后端环境变量模板
#
# 用法：复制为 server/.env（或仓库根目录 .env）后填写真实密钥
#   cp server/.env.example server/.env
#
# 配置优先级：应用内「系统设置 → 模型与 API 配置」 > .env > server/config.py 默认值
#
# 注意：所有 Key 一律留空，空值代表「未配置」，程序会给出明确报错或安全回退，
#      不会被误判为已配置。server/.env 已在 .gitignore 中，切勿提交真实密钥。
# ============================================================


# ------------------------------------------------------------
# 一、运行完整生成流程必须配置的项
#     剧本解析、分镜生成、配音、视频生成都依赖真实 API Key；
#     配置好本节各项，即可跑通「剧本 -> 分镜 -> 视频 -> 成片」。
# ------------------------------------------------------------

# --- 剧本 / 分镜 LLM ---
# 推荐使用 Mimo（小米 MiMo，OpenAI 兼容协议）。
# config.py 的内置默认值是 openai；未提供 .env 时会落到下面的 OPENAI_* 配置。
LLM_PROVIDER=mimo            # openai / deepseek / mimo / seeddance
LLM_MAX_TOKENS=4096
# 任务中心失败原因的 LLM 自动识别（关闭后仅保留关键词规则分类）
ERROR_ANALYSIS_LLM_ENABLED=true

# Mimo（小米 MiMo 官方接口）
MIMO_API_KEY=                # 【必填】留空 = 未配置，剧本解析会直接报错
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_MULTIMODAL_MODEL=mimo-v2-omni   # 图像理解 / 诊断用的多模态模型

# --- 视频生成：SeedDance（火山方舟，首帧图驱动） ---
ARK_API_KEY=                 # 【必填】火山方舟 Key，Seedream 图像与 SeedDance 视频共用
SEEDDANCE_API_KEY=           # 可选：单独指定视频 Key；留空则回退用 ARK_API_KEY
SEEDDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Seedance 系列（均走 /contents/generations/tasks；1.5 Pro 已于 2026-09 从模型列表下线）：
#   doubao-seedance-2-5-260628        旗舰，4~30s 长叙事、全模态参考，1080p 为 10bit H.265
#   doubao-seedance-2-0-260128        4~15s，支持 4k，音画同生（本链路强制无声）
#   doubao-seedance-2-0-fast-260128   快速版，仅 480p/720p
#   doubao-seedance-2-0-mini-260615   低成本版，仅 480p/720p
#   doubao-seedance-1-0-pro-250528 / doubao-seedance-1-0-pro-fast-251015
SEEDDANCE_MODEL=doubao-seedance-2-0-260128
VIDEO_PROVIDER=Doubao-Seedance-2.0

# --- 视频生成（可选二）：阿里云百炼 通义万相（dashscope-wanx 协议） ---
# VIDEO_PROVIDER 填 wanx / dashscope 时启用；也可在「系统设置 → 模型配置」中切换协议。
DASHSCOPE_API_KEY=           # 可选：百炼 API Key（Bearer 鉴权）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# 万相系列（均走 /services/aigc/video-generation/video-synthesis 异步任务）：
#   wan3.0-video / wan3.0-video-prime  新一代 All-in-One，480P/720P/1080P，2~30s（media 输入）
#   wan2.7-i2v / wan2.7-i2v-2026-04-25 图生视频，720P/1080P，2~15s（media 输入）
#   wan2.6-i2v / wan2.6-i2v-flash      旧代图生视频，720P/1080P，2~15s（img_url 输入）
#   wan2.5-i2v-preview                 早期预览版，480P/720P/1080P，仅 5/10 秒
DASHSCOPE_VIDEO_MODEL=wan2.7-i2v

# --- TTS 配音：固定使用 Mimo 内置 TTS ---
# 直接复用上面的 MIMO_API_KEY + MIMO_BASE_URL（mimo-tts 协议），没有独立的 TTS Key。
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=冰糖
MIMO_TTS_FORMAT=wav

# --- TTS 配音（可选二）：腾讯云语音合成（tencent-tts 协议） ---
# 配置 TENCENT_SECRET_ID/KEY 后，语音端点默认切换到腾讯云；系统设置中的 API Key 填 SecretId:SecretKey。
TENCENT_SECRET_ID=           # 可选：腾讯云 SecretId
TENCENT_SECRET_KEY=          # 可选：腾讯云 SecretKey
TENCENT_TTS_URL=https://tts.tencentcloudapi.com
TENCENT_TTS_VOICE=101001     # 默认音色：101001=智瑜（情感女声），完整列表见腾讯云音色文档
TENCENT_TTS_FORMAT=wav

# --- TTS 配音（可选三）：阿里云百炼语音合成（dashscope-tts 协议，CosyVoice） ---
# TTS_PROVIDER 填 dashscope / bailian / cosyvoice 后，语音端点默认切换到百炼；
# 也可在「系统设置 → 模型配置」中直接切换协议（与其他能力共用百炼 Key 时无需重复填写）。
TTS_PROVIDER=mimo
DASHSCOPE_TTS_API_KEY=       # 可选：留空则复用 DASHSCOPE_API_KEY
DASHSCOPE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_TTS_MODEL=cosyvoice-v2
DASHSCOPE_TTS_VOICE=longwan_v2   # 默认音色：longwan_v2=龙婉（温柔女声），完整列表见百炼 CosyVoice 文档
DASHSCOPE_TTS_FORMAT=wav


# ------------------------------------------------------------
# 二、可选配置（不配置也能启动，按需开启）
# ------------------------------------------------------------

# --- 图像生成：默认 local 占位图，无需任何密钥即可端到端跑通 ---
# local = PIL 占位图；ark-seedream = 火山方舟 Seedream；qwen-image = 阿里云百炼 Qwen-Image；stability = Stability AI。
# 配置了真实 provider 但缺少对应 Key 时，会自动回退到占位图，不中断流程。
IMAGE_PROVIDER=local
SEEDREAM_API_KEY=            # 可选：单独指定出图 Key；留空则回退用 ARK_API_KEY
# Seedream 系列（/images/generations；5.0 pro/flash 单图上限 2K 档，lite/4.5 到 4K 档）：
#   doubao-seedream-5-0-pro-260628 / doubao-seedream-5-0-flash-260915
#   doubao-seedream-5-0-lite-260128 / doubao-seedream-4-5-251128 / doubao-seedream-4-0-250828
SEEDREAM_MODEL=doubao-seedream-5-0-lite-260128
SEEDREAM_IMAGE_SIZE=1440x2560
# --- 阿里云百炼 Qwen-Image（千问图像生成与编辑） ---
QWEN_IMAGE_API_KEY=          # 可选：留空则复用 DASHSCOPE_API_KEY
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# qwen-image-3.0-pro / qwen-image-3.0（3.0 系列，同步多模态接口，总像素 512²~2048²）
# qwen-image-2.0-pro / qwen-image-2.0 / qwen-image-plus（旧系列）
QWEN_IMAGE_MODEL=qwen-image-3.0
QWEN_IMAGE_SIZE=1440x2560
STABILITY_API_KEY=           # 可选：IMAGE_PROVIDER=stability 时必填
STABILITY_API_URL=https://api.stability.ai/v2beta
# 参考图能力策略。适配器声明不支持参考图（qwen-image / stability / placeholder）时：
#   prefer（默认）= 先尝试切到「已配置且支持参考图」的图像 Provider（如 ark-seedream）；
#                   一个都没有时，明确告警并如实记录 references_sent=0 后继续生成，
#                   绝不假装参考图已生效（界面与日志都会标注能力限制）。
#   strict        = 同样先尝试切换；仍无可用参考图 Provider 时直接阻止生成。
# 两种取值都不会静默丢弃角色三视图 / 场景基准图 / 续帧参考。
IMAGE_REFERENCE_ENFORCEMENT=prefer
SD_LOCAL_URL=http://127.0.0.1:7860   # 本地 Stable Diffusion WebUI 地址

# --- 备用 LLM（主 LLM 不可用时的兜底渠道） ---
OPENAI_API_KEY=              # 可选：LLM_PROVIDER 非 mimo 时的主渠道，或 Mimo 的兜底
OPENAI_BASE_URL=             # 可选：OpenAI 兼容接口地址，留空用官方地址
OPENAI_MODEL=gpt-4o

# --- 服务与存储（均有内置默认值，一般无需修改） ---
# PORT=8011                          # 后端监听端口
# HOST=127.0.0.1                     # 绑定非本机地址时必须同时设置 COMIC_AGENT_LOCAL_TOKEN
# COMIC_AGENT_LOCAL_TOKEN=           # 桌面版由壳进程注入；手动部署到局域网时自行设置
# DATABASE_URL=sqlite:///server/data/comic_agent.db
# CHROMADB_PATH=server/data/chromadb
# DEFAULT_FPS=24
# DEFAULT_RESOLUTION=1080p           # 720p / 1080p / 2k / 4k

# --- 历史字段（保留兼容，当前流程不再按它切换实现） ---
# TTS_DEFAULT_VOICE=zh-CN-XiaoyiNeural   # 历史 edge-tts 音色名，已被 MIMO_TTS_VOICE 取代
# （TTS_PROVIDER 已启用为语音协议选择器：mimo / tencent / dashscope，见上方第三节）
