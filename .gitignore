# ============================================
# AI漫剧Agent - Global .gitignore
# ============================================

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini
*.lnk

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo
*~

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
.eggs/
*.so

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python type checking
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- Node / Electron ----
node_modules/
dist/
out/
release/
*.tgz

# Desktop bundle staging: bundled Python runtime + static ffmpeg produced by
# client/scripts/build-python-runtime.mjs (client/release/ output likewise).
client/build/
client/release/
# Electron 主进程/预加载产物由 vite-plugin-electron 构建时生成,不入库。
client/dist-electron/

# Electron
*.dmg
*.AppImage
*.deb
*.rpm
*.snap
*.exe
*.msi

# pnpm
pnpm-debug.yaml
# pnpm 内容寻址缓存:全局 store 与项目不在同一卷时会在项目根目录生成
.pnpm-store/

# ---- Environment & Secrets ----
.env
.env.local
.env.*.local
# Runtime model/API configuration may contain credentials. Keep only the
# sanitized example in version control.
server/data/model_api_config.json

# ---- Project Runtime Data ----
# Server output (generated images, audio, video)
output/
server/output/
# Uploaded scripts and imported media
server/data/uploads/
# ChromaDB vector store
server/data/chromadb/
# LangGraph checkpoints
server/data/checkpoints/
# SQLite database
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- Build Artifacts ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Misc ----
*.tmp
*.bak
*.cache

# ZCode 会话数据
.zcode/

# Python coverage artifacts
.coverage
coverage.txt
htmlcov/
coverage/
client/main.js
